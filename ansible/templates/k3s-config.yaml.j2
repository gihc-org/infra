# Managed by ansible/infra.yml — do not edit on the server, edit the template.
#
# disable traefik: ingress is managed ourselves via Helm (ingress-nginx / cert-manager)
# flannel-iface: use the private network interface so pod traffic stays off the public internet.
#   Ubuntu 24.04 uses predictable network interface naming based on PCI slot,
#   so the private NIC is "enp7s0", not "eth1" — verify with `ip -brief addr`
#   if this ever changes (e.g. after a server_type change).
# node-ip: advertise the private IP as the node address
# tls-san: add the public IPv4 to the k3s API server certificate so kubectl can connect from outside
disable:
  - traefik
flannel-iface: enp7s0
node-ip: "{{ k3s_node_ip }}"
tls-san:
  - "{{ ansible_host }}"
