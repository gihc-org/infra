# hcloud_token sættes som miljøvariabel — ikke her:
#   export HCLOUD_TOKEN="dit-hetzner-api-token"
#
# S3 state backend credentials sættes som miljøvariabler:
#   export AWS_ACCESS_KEY_ID="dit-access-key"
#   export AWS_SECRET_ACCESS_KEY="dit-secret-key"
#
# Alle variabler nedenfor har allerede korrekte defaults i variables.tf.
# Opret kun en terraform.tfvars hvis du vil overstyre en default.

# server_name         = "ubuntu-4gb-hel1-1"
# server_type         = "cpx22"
# server_location     = "hel1"
# ssh_public_key_path = "~/.ssh/id_ed25519.hetzner.pub"
# network_zone        = "eu-central"
# network_ip_range    = "10.0.0.0/8"
# subnet_ip_range     = "10.0.1.0/24"
