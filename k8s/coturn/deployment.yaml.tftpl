# coturn — delt TURN-relay for alle apps på noden (ADR 0003).
#
# Templatet rendres af `tofu/platform.tf` (kubectl_manifest) med:
#   image       — pinnet tag + digest (se tofu/variables.tf)
#   realm       — turn.gihc.online
#   external_ip — nodens offentlige IP (fra hcloud_server.platform)
#
# Bemærk: Terraform-interpolation skrives med dollar og krølleklammer, mens
# pod'ens egne variabler skrives $(NAVN) og ekspanderes af imagets entrypoint —
# de to kolliderer ikke.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: coturn
  namespace: coturn
  labels:
    app: coturn
    app.kubernetes.io/name: coturn
    app.kubernetes.io/part-of: platform
spec:
  replicas: 1
  # Alt på noden er ét pod-liv: Recreate undgår at to pods kortvarigt kæmper om
  # de samme hostNetwork-porte under et deploy.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: coturn
  template:
    metadata:
      labels:
        app: coturn
    spec:
      # TURN kan ikke ligge bag ingress-nginx (rene TCP/UDP-porte).
      # Firewall-regler: TCP+UDP 3478, UDP 49152–49200 i infra/tofu/main.tf.
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      containers:
        - name: coturn
          image: ${image}
          args:
            - "--log-file=stdout"
            - "--use-auth-secret"
            - "--static-auth-secret=$(STATIC_AUTH_SECRET)"
            - "--fingerprint"
            - "--no-multicast-peers"
            # Ingen `--no-cli`: CLI'en er slået fra som standard i coturn 4.18
            # ("By default it is always OFF"), og flaget er deprecated — det
            # logger "ERROR no-cli option is deprecated, see --cli" ved start.
            - "--realm=${realm}"
            - "--external-ip=${external_ip}"
            # Uden --relay-ip finder coturn alle nodens interfaces (også de
            # private 10.x-adresser) og advarer "NO EXPLICIT RELAY ADDRESS(ES)
            # ARE CONFIGURED". Relay-trafik skal kun findes på den offentlige
            # IP, så en klient ikke kan få en ubrugelig privat relay-kandidat.
            - "--relay-ip=${external_ip}"
            - "--min-port=49152"
            - "--max-port=49200"
            # Prometheus-metrics på 9641 (hostNetwork). Porten er ikke åbnet i
            # Hetzner-firewall'en, så den kan kun nås på noden/clusteret.
            - "--prometheus"
            - "--prometheus-port=9641"
            # `-n` (ignorér config-fil) er bevidst udeladt: imagets entrypoint
            # kører `eval "echo $i"` på hvert argument, og `echo -n` bliver til
            # en tom streng — coturn får derfor et tomt argument og logger
            # "Unknown argument:" ved hver start. Imaget har ingen
            # turnserver.conf, så der er intet at læse.
            #
            # Misbrugsbeskyttelse: STATIC_AUTH_SECRET ligger i frontendernes
            # config.js og er dermed offentlig — enhver kan udstede
            # HMAC-credentials. Disse grænser bestemmer, hvad en sådan
            # credential kan bruges til.
            # 1) Relayer må ikke kunne nå private/interne adresser (RFC1918,
            #    loopback, link-local, CGNAT og IPv6-ækvivalenter), så TURN ikke
            #    kan bruges som springbræt ind i nodens netværk.
            - "--denied-peer-ip=0.0.0.0-0.255.255.255"
            - "--denied-peer-ip=10.0.0.0-10.255.255.255"
            - "--denied-peer-ip=100.64.0.0-100.127.255.255"
            - "--denied-peer-ip=127.0.0.0-127.255.255.255"
            - "--denied-peer-ip=169.254.0.0-169.254.255.255"
            - "--denied-peer-ip=172.16.0.0-172.31.255.255"
            - "--denied-peer-ip=192.168.0.0-192.168.255.255"
            - "--denied-peer-ip=::1"
            - "--denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff"
            - "--denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff"
            # 2) Kvoter: 2 Mbit/s pr. session, 50 Mbit/s i alt, 8 samtidige
            #    allocationer pr. credential og 40 i alt (delt på tværs af alle
            #    apps — hæv ved behov, se ADR 0003).
            #    VIGTIGT ved tuning: hver peer-forbindelse i meshen bruger én
            #    allocation, så et loft med mere end ~8 deltagere rammer
            #    --user-quota først. Hæv den (og --total-quota) hvis loftene
            #    vokser; relay-portintervallet (49 porte) er den anden grænse.
            - "--max-bps=2000000"
            - "--bps-capacity=50000000"
            - "--user-quota=8"
            - "--total-quota=40"
            - "--stale-nonce=600"
          env:
            - name: STATIC_AUTH_SECRET
              valueFrom:
                secretKeyRef:
                  # Oprettet imperativt fra `pass turn/static-auth-secret` af
                  # scripts/deploy-coturn.sh — værdien findes aldrig i git.
                  name: coturn-secret
                  key: static-auth-secret
          # TURN-porten er hostnetværkets 3478 — et svar her beviser at
          # coturn faktisk lyttet (og dermed at firewall-reglerne virker).
          readinessProbe:
            tcpSocket:
              port: 3478
            initialDelaySeconds: 2
            periodSeconds: 5
          livenessProbe:
            tcpSocket:
              port: 3478
            initialDelaySeconds: 10
            periodSeconds: 30
          # Hærdning (verificeret på loft-test 2026-09-11): coturn kører uden
          # root, uden rettigheder den ikke bruger, og med read-only rootfs.
          #
          # Fælden: /usr/bin/turnserver bærer file-capabilities. Tømmer man
          # bounding-settet helt (`drop: ["ALL"]` uden `add`), nægter kernelen
          # `execve` af binæren med "Operation not permitted" — pod'en crasher i
          # en loop. NET_BIND_SERVICE skal derfor stå i bounding-settet for at
          # exec lykkes, men med `no_new_privs` bliver den ikke givet videre til
          # processen (CapEff=0).
          securityContext:
            runAsUser: 65534
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
              add: ["NET_BIND_SERVICE"]
          resources:
            requests:
              cpu: 50m
              memory: 32Mi
            limits:
              cpu: 250m
              memory: 128Mi
